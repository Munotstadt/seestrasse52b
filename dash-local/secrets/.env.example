# Ablage: secrets/.env
# Bestehender Sensor-Container (liefert /api/latest und /api/series), von diesem Container aus erreichbar
SENSOR_API_URL=http://192.168.86.30:3000

# Solar-Manager-Viewer (Energy-Seite). Falls der Container die NAS-IP nicht erreicht: Container-Name + Netzwerk, z. B. http://solarmanager-viewer:8053
SOLAR_API_URL=http://192.168.86.30:8053

# Licht & Blinds (Container wiser-storen, läuft im Host-Netzwerk). Siehe README, falls der Container die NAS-IP nicht erreicht
WISER_API_URL=http://192.168.86.30:8085

# Cloudflare D1 (nur Lesezugriff genügt: API-Token mit Berechtigung "D1 – Lesen")
CF_ACCOUNT_ID=
CF_API_TOKEN=
# Datenbank "meteo" (Standardwert, nur setzen falls abweichend)
# CF_D1_METEO_ID=17e827ee-3f96-4ce9-b93c-be3cea624448

# myStrom Switch der Wasserpumpe (IP, optional mit :Port)
wasserpumpe=192.168.86.27

# MariaDB mit den Škoda-Daten (am besten ein Nur-Lese-Benutzer, siehe README)
DB_HOST=192.168.86.30
DB_PORT=3306
DB_USER=dashboard_ro
DB_PASSWORD=
DB_NAME=52b_seestrasse_logger

# MyŠkoda Public API (gleicher Key wie im skoda-enyaq-collector; erzeugt in der MyŠkoda-App: go.skoda.eu/api-keys)
SKODA_API_KEY=
SKODA_VIN=TMBLE9NYXNF026871
